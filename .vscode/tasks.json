  "version": "2.0.0",
  "tasks": [
    {
      "label": "MDCC: Sync official documentation",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/sync-mdcc-docs.ps1"
      ],
      "windows": {
        "command": "powershell.exe"
      },
      "linux": {
        "command": "bash",
        "args": ["${workspaceFolder}/scripts/sync-mdcc-docs.sh"]
      },
      "osx": {
        "command": "bash",
        "args": ["${workspaceFolder}/scripts/sync-mdcc-docs.sh"]
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
