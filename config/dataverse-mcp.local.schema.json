{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MDCC local environment catalog (no credentials)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "activeEnvironment", "environments"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "activeEnvironment": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "environments": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "environmentUrl", "classification"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "environmentUrl": { "type": "string", "pattern": "^https://[a-z0-9-]+\\.crm[0-9]*\\.dynamics\\.com/?(api/mcp/?)?$" },
          "classification": { "enum": ["development", "test", "production", "unconfirmed"] }
        }
      }
    }
  }
}
